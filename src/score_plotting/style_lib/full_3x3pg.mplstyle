#### matplotlib style file for AGU figures

### FONT
font.size : 12
font.family: serif
font.sans-serif: FreeSans, Roboto, Arial
font.serif: Noto Serif CJK JP

### TEXT
#text.usetex : True

### AXES
axes.titlesize : 12
axes.labelsize : 12

### TICKS
xtick.labelsize : 12
ytick.labelsize : 12

### Legend
legend.fontsize : 12

### FIGURE
figure.titlesize : 12
figure.figsize : 24, 27.18

### SAVING FIGURES
savefig.format : pdf
