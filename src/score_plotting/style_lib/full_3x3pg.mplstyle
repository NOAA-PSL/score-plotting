#### matplotlib style file for AGU figures

### FONT
font.size : 10
font.family: serif
font.sans-serif: Helvetica Neue, FreeSans, Roboto, Arial
font.serif: Noto Serif CJK JP

### TEXT
#text.usetex : True

### AXES
axes.titlesize : 10
axes.labelsize : 10

### TICKS
xtick.labelsize : 10
ytick.labelsize : 10

### Legend
legend.fontsize : 10

### FIGURE
figure.titlesize : 10
figure.figsize : 24, 27.18

### SAVING FIGURES
savefig.format : pdf
