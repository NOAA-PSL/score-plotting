#### matplotlib style file for AGU figures

### FONT
font.size: 12
font.family: serif
font.sans-serif: Helvetica Neue, FreeSans, Roboto, Arial, Helvetica
font.serif: Noto Serif CJK JP

### TEXT
#text.usetex : True

### AXES
axes.titlesize : 12
axes.labelsize : 12

### TICKS
xtick.labelsize : 12
ytick.labelsize : 12

### Legend
legend.fontsize : 12

### FIGURE
figure.titlesize : 12
figure.figsize : 7.48, 4.53

### SAVING FIGURES
savefig.format : pdf
